{
  "name": "nihongopro",
  "version": "1.0.0",
  "private": true,
  "description": "Nihongo Pro Academy \u2014 platform pembelajaran bahasa Jepang, Kaigo, dan persiapan kerja di Jepang. Situs statis (335+ halaman HTML) dengan Netlify Functions untuk AI chat, payment, dan live class token.",
  "scripts": {
    "build": "node scripts/build-assets.mjs",
    "build:check": "node scripts/build-assets.mjs --check",
    "build:srs": "node scripts/build-srs-catalog.js",
    "build:srs:check": "node scripts/build-srs-catalog.js --check",
    "validate": "python3 scripts/validate.py",
    "test": "node scripts/tests/run-all.js",
    "test:min": "NP_PLATFORM=min node scripts/tests/run-all.js",
    "test:kaigo-browser": "node scripts/tests/browser/test-kaigo-simulator.js",
    "test:srs-catalog-browser": "node scripts/tests/browser/test-srs-catalog.js",
    "test:payment-certificate-browser": "node scripts/tests/browser/test-payment-certificate.js",
    "test:kanji-writing-browser": "node scripts/tests/browser/test-kanji-writing-modal.js",
    "test:anatomy-3d-browser": "node scripts/tests/browser/test-anatomy-3d.js",
    "test:ai-sensei-browser": "node scripts/tests/browser/test-ai-sensei.js",
    "release": "node scripts/release.js",
    "release:dry": "node scripts/release.js --dry-run",
    "test:ssw-flow-browser": "node scripts/tests/browser/test-ssw-flow.js",
    "audit:ssw": "node scripts/audit-ssw-content.js",
    "build:ssw": "node scripts/build-ssw-content.js",
    "build:ssw:check": "node scripts/build-ssw-content.js --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "livekit-server-sdk": "^2.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1"
  }
}
