# ============================================================
# NihongoPro v12+ — Environment Variables
# Copy ke .env lalu isi nilainya. JANGAN commit .env ke git!
# ============================================================

# ── SITE ─────────────────────────────────────────────────────
EDUMA_SITE_URL=https://nihonggopro.id
EDUMA_AI_API_ENDPOINT=/api/ai-chat

# ── AI PROVIDERS (isi minimal satu) ──────────────────────────
# Anthropic Claude — direkomendasikan (paling baik untuk Jepang)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI GPT
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── SUPABASE (auth + cloud sync progress) ────────────────────
EDUMA_SUPABASE_URL=https://xxxx.supabase.co
EDUMA_SUPABASE_ANON_KEY=eyJ...
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Rahasia server-side saja; jangan expose ke frontend.
SUPABASE_SERVICE_KEY=

# ── ADMIN ───────────────────────────────────────────────────
NIHONGO_ADMIN_LOGIN_ENDPOINT=/api/admin-login

# ── PAYMENT (Midtrans) ──────────────────────────────────────
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Hanya di environment server/Netlify, jangan masukkan ke env.js.
MIDTRANS_SERVER_KEY=

# ── LIVE CLASSROOM ──────────────────────────────────────────
PEERJS_HOST=
PEERJS_PORT=443
PEERJS_PATH=/myapp
TURN_URL=
TURN_URL_TCP=
TURN_URL_TLS=
TURN_USERNAME=
TURN_CREDENTIAL=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── ANALYTICS ────────────────────────────────────────────────
EDUMA_GSC_VERIFICATION=paste_kode_gsc_di_sini
EDUMA_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── EMAIL (opsional, untuk form kontak) ──────────────────────
EDUMA_EMAILJS_PUBLIC_KEY=
EDUMA_EMAILJS_SERVICE_ID=
EDUMA_EMAILJS_TEMPLATE_ID=

# ── RATE LIMIT (opsional, Redis/Upstash) ─────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── CARA DEPLOY ──────────────────────────────────────────────
# Vercel:
#   vercel env add ANTHROPIC_API_KEY
#   vercel deploy
#
# Netlify:
#   netlify env:set ANTHROPIC_API_KEY "sk-ant-..."
#   netlify deploy --prod
